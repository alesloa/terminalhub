# Terminal Hub configuration. Copy this to .env (setup.sh does it for you) and edit.
# The server reads these at boot. An inline `VAR=… npm start` overrides the file.
# All vars use the TERMINALHUB_ prefix.

# Remote-access token. REQUIRED to reach Terminal Hub over a tunnel or non-loopback
# host; loopback (localhost) connections never need it. Generate one with:
#     openssl rand -hex 32
# Paste the SAME value into Settings -> Access token on each remote device.
TERMINALHUB_TOKEN=

# Stealth curtain (optional). When set, a remote/exposed visitor who loads Terminal Hub WITHOUT this
# exact query param gets a blank page — no UI, no hint anything is here. localhost / 127.0.0.1
# always see the app whether it's set or not. This only hides the UI; TERMINALHUB_TOKEN is still the
# real lock. Format is name=value, so the reveal URL becomes  https://your-host/?name=value
# (the param rides in the URL and lands in logs/history — treat it as obscurity, not a password).
# TERMINALHUB_REVEAL=secret=changeme

# Dev-server host allowlist (Vite, `npm run dev` only). Vite blocks any non-loopback
# Host header unless it's listed here, so a tunnel hostname must be added or it 404s
# with "This host is not allowed". Comma-separated; `*` allows any host. Production
# (`npm start`, Fastify) ignores this. Restart `npm run dev` after changing.
# TERMINALHUB_ALLOWED_HOSTS=terminal.example.com

# Network binding. Default 127.0.0.1 (loopback) is correct when a tunnel
# (e.g. cloudflared) fronts Terminal Hub. Set 0.0.0.0 to bind all interfaces for a
# direct LAN/public bind — the server then refuses to boot without a token.
# HOST=127.0.0.1
# PORT=8189

# SQLite database path. Default is data/terminalhub.db, resolved from the process cwd — which
# DIFFERS between `npm run dev` (cwd=server/) and `npm start`/pm2 (cwd=repo root), so a relative
# path silently becomes two separate DBs. Use an ABSOLUTE path so every launch shares one database:
# TERMINALHUB_DB=/absolute/path/to/terminal-hub/server/data/terminalhub.db

# Comma-separated folder allowlist for the filesystem API when exposed.
# FS_ROOTS=/home/me/projects,/srv/code

# Secret-link backend (optional). The "Secret" tool mints burnable, encrypted links on a
# Yopass-compatible "onetime" instance. Point this at your own instance to enable the feature;
# the server encrypts with the host's gpg (must be on PATH) and uploads only ciphertext. Unset =
# the feature is disabled. No instance is baked in.
# ONETIME_BASE=https://onetime.example.com
