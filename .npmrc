# @anthropic-ai/claude-agent-sdk declares a peer dependency on zod ^4, but it never imports zod at
# runtime — its published bundle contains zero zod imports. The peer exists only for the optional
# in-process MCP `tool()` helper, which this server does not use. Its type declarations import the
# `zod/v4` subpath, which zod 3.25 already ships, so `tsc` resolves them without a zod upgrade.
#
# npm has no way to relax a single package's peer range (`overrides` does not apply to peers), and
# dragging the whole server from zod 3 to zod 4 would rewrite validation in ~50 route files for no
# functional gain. So peer resolution is relaxed repo-wide instead.
legacy-peer-deps=true
